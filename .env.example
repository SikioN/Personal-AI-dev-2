# ==============================================================================
# КОНФИГУРАЦИЯ БОТА (TELEGRAM)
# ==============================================================================
# Токен вашего бота, полученный от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ==============================================================================
# НАСТРОЙКИ LLM 
# ==============================================================================
# Выберите провайдера: deepseek | ollama | yandexgpt | gigachat | openai | qwen
LLM_BACKEND=deepseek

# --- DeepSeek ---
DEEPSEEK_API_KEY=ваш_ключ_api
DEEPSEEK_MODEL=deepseek-chat

# --- Ollama (Для локального запуска моделей) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- YandexGPT ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt

# --- GigaChat (Sber) ---
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat

# --- OpenAI (ChatGPT) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# ХРАНИЛИЩЕ ГРАФА
# ==============================================================================
# Движок базы данных:
#   - kuzu   (Встроенная БД)
#   - neo4j  (Требует запущенного сервера Neo4j)
GRAPH_BACKEND=kuzu

# Режим работы:
#   - false (Production): Данные сохраняются в базу на диске (папка data/kuzu_db)
#   - true  (In-Memory): Данные хранятся временно, стираются при перезагрузке
USE_INMEMORY=false

# --- Путь к базе KuzuDB (если GRAPH_BACKEND=kuzu) ---
KUZU_PATH=data/kuzu_db

# --- Настройки Neo4j (если GRAPH_BACKEND=neo4j) ---
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DB=neo4j

# ==============================================================================
# ВЕКТОРНОЕ ХРАНИЛИЩЕ 
# ==============================================================================
# Пути к индексам ChromaDB для семантического поиска
CHROMA_NODES_PATH=data/graph_structures/vectorized_nodes/default
CHROMA_QUADS_PATH=data/graph_structures/vectorized_quadruplets/default

# ==============================================================================
# ПУТИ К МОДЕЛЯМ И СИСТЕМНЫМ ДАННЫМ
# ==============================================================================
# Путь к дообученной E5-модели (sentence-transformers)
FINETUNED_MODEL_PATH=models/e5

# Обученные веса модели TComplEx
TCOMPLEX_CHECKPOINT=models/cronkgqa/tcomplex.ckpt

# Путь к предобработанному графу Wikidata (pickle-файлы TComplEx)
TCOMPLEX_DATA_PATH=wikidata_big/kg/tkbc_processed_data/wikidata_big

# Базовая папка с описаниями сущностей и full.txt
KG_DATA_PATH=wikidata_big/kg

# ==============================================================================
# ПУТИ К СЛУЖЕБНЫМ ФАЙЛАМ ПАЙПЛАЙНА
# ==============================================================================
# Директория для извлечённых данных (реестр ID, манифест обработанных файлов)
EXTRACT_DATA_DIR=extract_data

# Файл состояния ингестии (статистика добавленных фактов)
INGEST_STATS_PATH=data/ingest_stats.json

# Файл stash для in-memory режима (сохранение фактов между перезапусками)
INMEMORY_STASH_PATH=data/inmemory_stash.json

# Директория с документами для batch-ингестии (setup.sh --build-kg)
INGEST_DIR=extract/new_docs

# ==============================================================================
# ПРОЧЕЕ
# ==============================================================================
# HuggingFace Token (для скачивания весов из приватных репозиториев)
HF_TOKEN=
