# ============================================================
# Telegram Bot
# ============================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================================
# LLM Backend — choose one: ollama | yandexgpt | deepseek | gigachat | openai | qwen
# ============================================================
LLM_BACKEND=deepseek

# --- YandexGPT ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- GigaChat (Sber) ---
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat

# --- OpenAI / ChatGPT ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Qwen (DashScope) ---
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# --- Ollama (self-hosted) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ============================================================
# Graph DB — Neo4j (optional; used when GRAPH_BACKEND=neo4j)
# ============================================================
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DB=neo4j

# ============================================================
# Graph DB — KuzuDB (embedded; used when GRAPH_BACKEND=kuzu)
# ============================================================
KUZU_PATH=data/kuzu_db

# ============================================================
# Vector DB — ChromaDB (file-based, no host/port needed)
# ============================================================
CHROMA_NODES_PATH=data/graph_structures/vectorized_nodes/default
CHROMA_QUADS_PATH=data/graph_structures/vectorized_quadruplets/default

# ============================================================
# Models & Data paths (relative to project root for bare-metal)
# ============================================================
FINETUNED_MODEL_PATH=models/wikidata_finetuned_remote/wikidata_finetuned
TCOMPLEX_CHECKPOINT=models/cronkgqa/tcomplex.ckpt
TCOMPLEX_DATA_PATH=wikidata_big/kg/tkbc_processed_data/wikidata_big

# ============================================================
# KG data directory (contains full.txt, wd_id2entity_text.txt, etc.)
# ============================================================
KG_DATA_PATH=wikidata_big/kg
