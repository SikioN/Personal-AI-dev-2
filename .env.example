# ============================================================
# Telegram Bot
# ============================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================================
# LLM Backend — choose one: ollama | yandexgpt | deepseek | gigachat | openai | qwen
# ============================================================
LLM_BACKEND=yandexgpt

# --- YandexGPT ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- GigaChat (Sber) ---
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat

# --- OpenAI / ChatGPT ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Qwen (DashScope) ---
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# --- Ollama (self-hosted) ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# ============================================================
# Graph DB — Neo4j
# ============================================================
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DB=neo4j

# ============================================================
# Vector DB — ChromaDB
# ============================================================
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ============================================================
# Models & Data paths (mounted as volumes in Docker)
# ============================================================
FINETUNED_MODEL_PATH=/app/models/wikidata_finetuned_remote/wikidata_finetuned
TCOMPLEX_CHECKPOINT=/app/models/cronkgqa/tcomplex.ckpt
TCOMPLEX_DATA_PATH=/app/wikidata_big/kg/tkbc_processed_data/wikidata_big
